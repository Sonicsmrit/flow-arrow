# Which model the backend uses (hosted Gemma 4).
MODEL_PROVIDER=gemma

# Hosted Gemma 4 key. Fill in and restart the server. Never commit this file.
GEMMA_API_KEY=
# Bake-off winner 2026-10-09 (6 cases, identical inputs): 26b-a4b-it 6/6 @ p50 ~3-5s,
# 0 failures. 31b-it disqualified (p50 28s + timeouts). Knobs: temperature 0,
# thinking_level minimal (A/B beats thinking-off on speed at equal accuracy), no max-output cap.
GEMMA_MODEL=gemma-4-26b-a4b-it

PORT=8787

# Local Nepali speech-to-text container (server/voice)
WHISPER_URL=http://localhost:8790
